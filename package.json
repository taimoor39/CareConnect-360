{
  "name": "mern-stack-project",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "seed:admin": "npm run seed:admin --workspace backend",
    "dev": "npm run seed:admin && concurrently -n backend,frontend,ai -c green,cyan,magenta \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\" \"npm run dev:ai\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:ai": "node scripts/dev-ai.mjs",
    "dev:ai:reload": "node scripts/dev-ai.mjs --reload",
    "health": "node scripts/health-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
