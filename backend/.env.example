PORT=5000
TZ=Asia/Karachi
MONGODB_URI=mongodb://127.0.0.1:27017/mern-stack-project
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
SEEDERS_CONFIG_PATH=src/config/seeders.json

