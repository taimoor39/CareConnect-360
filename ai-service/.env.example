# CareConnect 360 AI Service — optional overrides
# Copy to .env and restart. Unset variables keep the defaults below.
# These are the only names read via os.environ in ai-service/app/.

# Hugging Face model id (default: DistilBART, ~500 MB).
# Larger/slower alternative: facebook/bart-large-cnn (~1.6 GB).
SUMMARIZATION_MODEL_ID=sshleifer/distilbart-cnn-12-6

# Seconds to wait for weights to load at warmup.
MODEL_LOAD_TIMEOUT_SEC=300

# Seconds a summarize request will wait for the model to become ready.
REQUEST_MODEL_WAIT_SEC=280

# Wall-clock cap for a single BART generate() call (then extractive fallback).
BART_INFERENCE_TIMEOUT_SEC=60
